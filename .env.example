# Copy to .env and fill in. LLM_BASE_URL comes from the Colab notebook output —
# it CHANGES every time the notebook restarts (quick tunnels rotate).
LLM_BASE_URL=https://xxxx-xxxx.trycloudflare.com/v1
LLM_API_KEY=lightgent-change-me
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Multi-Colab: run the notebook in 2+ Colab sessions and paste every LLM URL
# here (comma-separated, each ending in /v1). The batch runner round-robins
# rows across them for N-times throughput. Leave empty to use LLM_BASE_URL.
LLM_BASE_URLS=

# SearXNG endpoint (the Colab notebook runs its own and prints this URL).
# With many sessions, list all their SEARXNG URLs in SEARXNG_URLS to spread
# search load and survive one dying; falls back to SEARXNG_URL.
SEARXNG_URL=https://yyyy-yyyy.trycloudflare.com
SEARXNG_URLS=
SEARXNG_TOKEN=

# Optional comma-separated SOCKS5 proxies for Jina page fetches (empty = direct)
JINA_PROXIES=

MAX_ITERATIONS=12
MAX_CONCURRENT=3
LLM_TIMEOUT=180
TOOL_TIMEOUT=45
